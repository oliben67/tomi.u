# Structs and Data Classes
# Demonstrates: struct definitions, field access, struct initialization

struct Point:
    x: i32
    y: i32

struct Rectangle:
    width: i32
    height: i32

struct Color:
    r: i32
    g: i32
    b: i32

def make_point(x: i32, y: i32) -> Point:
    return Point { x: x, y: y }

def rect_area(r: Rectangle) -> i32:
    return r.width * r.height

def rect_perimeter(r: Rectangle) -> i32:
    return 2 * (r.width + r.height)

def distance_squared(a: Point, b: Point) -> i32:
    let dx = b.x - a.x
    let dy = b.y - a.y
    return dx * dx + dy * dy

def color_brightness(c: Color) -> i32:
    return (c.r + c.g + c.b) / 3

@entrypoint
def main():
    let origin = Point { x: 0, y: 0 }
    let p = make_point(3, 4)
    print(p.x)
    print(p.y)

    let dist_sq = distance_squared(origin, p)
    print(dist_sq)

    let rect = Rectangle { width: 10, height: 5 }
    print(rect_area(rect))
    print(rect_perimeter(rect))

    let red = Color { r: 255, g: 0, b: 0 }
    let grey = Color { r: 128, g: 128, b: 128 }
    print(color_brightness(red))
    print(color_brightness(grey))
