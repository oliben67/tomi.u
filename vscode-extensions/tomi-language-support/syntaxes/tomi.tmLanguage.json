{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tomi",
  "scopeName": "source.tomi",
  "patterns": [
    {"include": "#comments"},
    {"include": "#markers"},
    {"include": "#decorators"},
    {"include": "#keywords"},
    {"include": "#strings"},
    {"include": "#numbers"},
    {"include": "#types"},
    {"include": "#operators"},
    {"include": "#functions"},
    {"include": "#classes"},
    {"include": "#generics"},
    {"include": "#graph-expressions"},
    {"include": "#identifiers"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.tomi",
          "match": "#.*$"
        },
        {
          "name": "comment.block.tomi",
          "begin": "'''",
          "end": "'''",
          "patterns": [
            {
              "name": "constant.character.escape.tomi",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "markers": {
      "patterns": [
        {
          "name": "storage.type.annotation.tomi",
          "match": "::(entrypoint|entry|ep|create|c|destroy|del|d)\\b",
          "captures": {
            "1": {"name": "entity.name.function.decorator.tomi"}
          }
        },
        {
          "name": "storage.type.annotation.tomi",
          "begin": "::([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\[",
          "end": "\\]",
          "beginCaptures": {
            "1": {"name": "entity.name.function.decorator.tomi"}
          },
          "patterns": [
            {"include": "#expressions"}
          ]
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "storage.type.annotation.tomi",
          "match": "@[a-zA-Z_][a-zA-Z0-9_.]*",
          "captures": {
            "0": {"name": "entity.name.function.decorator.tomi"}
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tomi",
          "match": "\\b(def|class|if|elif|else|for|while|break|continue|return|import|from|as|try|catch|except|finally|raise|with|match|case|pass|async|await)\\b"
        },
        {
          "name": "keyword.operator.logical.tomi",
          "match": "\\b(and|or|not|in|is)\\b"
        },
        {
          "name": "constant.language.tomi",
          "match": "\\b(True|False|None)\\b"
        },
        {
          "name": "keyword.other.graph.tomi",
          "match": "\\b(query|match|where|return|Graph|Node|Edge)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.tomi",
          "begin": "'",
          "end": "'",
          "patterns": [
            {"include": "#string-escapes"}
          ]
        },
        {
          "name": "string.quoted.double.tomi",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {"include": "#string-escapes"}
          ]
        },
        {
          "name": "string.quoted.other.format.tomi",
          "begin": "f[\"']",
          "end": "[\"']",
          "patterns": [
            {"include": "#string-escapes"},
            {
              "name": "meta.embedded.line.tomi",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {"include": "#expressions"}
              ]
            }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.tomi",
          "match": "\\\\[nrtbfav\\\\\"'\\{\\}]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.tomi",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.tomi",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.tomi",
          "match": "\\b(int|float|str|bool|list|dict|tuple|Graph|Node|Edge|Any)\\b"
        },
        {
          "name": "support.type.generic.tomi",
          "match": "\\b(List|Dict|Tuple|Optional|Union)\\b"
        },
        {
          "name": "storage.type.annotation.tomi",
          "match": ":\\s*([a-zA-Z_][a-zA-Z0-9_]*(?:<[^>]+>)?(?:\\s*\\|\\s*[a-zA-Z_][a-zA-Z0-9_]*(?:<[^>]+>)?)*)",
          "captures": {
            "1": {"patterns": [{"include": "#type-expressions"}]}
          }
        }
      ]
    },
    "type-expressions": {
      "patterns": [
        {"include": "#generics"},
        {"include": "#types"},
        {
          "name": "keyword.operator.union.tomi",
          "match": "\\|"
        },
        {
          "name": "punctuation.definition.optional.tomi",
          "match": "\\?"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.tomi",
          "match": "=(?!=)"
        },
        {
          "name": "keyword.operator.comparison.tomi",
          "match": "==|!=|<=|>=|<(?!=)|>(?!=)"
        },
        {
          "name": "keyword.operator.arithmetic.tomi",
          "match": "\\+|\\-|\\*{1,2}|\\/|\\/\\/|%"
        },
        {
          "name": "keyword.operator.arrow.tomi",
          "match": "->"
        },
        {
          "name": "punctuation.separator.colon.tomi",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.tomi",
          "match": ","
        },
        {
          "name": "punctuation.definition.arguments.begin.tomi",
          "match": "\\("
        },
        {
          "name": "punctuation.definition.arguments.end.tomi",
          "match": "\\)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.tomi",
          "begin": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "end": ":",
          "beginCaptures": {
            "1": {"name": "keyword.control.tomi"},
            "2": {"name": "entity.name.function.tomi"}
          },
          "patterns": [
            {"include": "#generics"},
            {"include": "#function-parameters"}
          ]
        },
        {
          "name": "support.function.builtin.tomi",
          "match": "\\b(print|len|str|int|float|bool|range|enumerate|zip|list|dict|tuple)\\b"
        }
      ]
    },
    "function-parameters": {
      "patterns": [
        {
          "name": "meta.function.parameters.tomi",
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {"include": "#types"},
            {"include": "#identifiers"},
            {"include": "#operators"}
          ]
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "meta.class.tomi",
          "begin": "\\b(class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "end": ":",
          "beginCaptures": {
            "1": {"name": "keyword.control.tomi"},
            "2": {"name": "entity.name.class.tomi"}
          },
          "patterns": [
            {"include": "#generics"},
            {"include": "#class-inheritance"}
          ]
        }
      ]
    },
    "class-inheritance": {
      "patterns": [
        {
          "name": "meta.class.inheritance.tomi",
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {"include": "#identifiers"},
            {"include": "#operators"}
          ]
        }
      ]
    },
    "generics": {
      "patterns": [
        {
          "name": "meta.generic.tomi",
          "begin": "<",
          "end": ">",
          "patterns": [
            {"include": "#types"},
            {"include": "#identifiers"},
            {
              "name": "punctuation.separator.comma.tomi",
              "match": ","
            }
          ]
        }
      ]
    },
    "graph-expressions": {
      "patterns": [
        {
          "name": "meta.graph.query.tomi",
          "begin": "\\b(query)\\s+",
          "end": "(?=\\s*\\{)",
          "beginCaptures": {
            "1": {"name": "keyword.other.graph.tomi"}
          },
          "patterns": [
            {"include": "#identifiers"}
          ]
        },
        {
          "name": "string.regexp.cypher.tomi",
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "name": "entity.name.tag.cypher.tomi",
              "match": ":[A-Z_][A-Z0-9_]*"
            },
            {
              "name": "keyword.operator.cypher.tomi",
              "match": "-\\[.*?\\]->"
            }
          ]
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.tomi",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "expressions": {
      "patterns": [
        {"include": "#strings"},
        {"include": "#numbers"},
        {"include": "#operators"},
        {"include": "#identifiers"}
      ]
    }
  }
}